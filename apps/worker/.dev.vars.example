# Copy to .dev.vars (git-ignored) for local development: cp .dev.vars.example .dev.vars
# wrangler dev loads .dev.vars; values here override [vars] in wrangler.toml, so local overrides
# never touch committed config.

# Secrets (placeholders; use a Google OAuth client with the local redirect URI registered)
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
# At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx

# Exact Online (placeholders). TOKEN_ENC_KEY: openssl rand -base64 32
EXACT_CLIENT_SECRET=replace-with-exact-app-secret
TOKEN_ENC_KEY=replace-with-32-random-bytes-in-base64-xxxxxxxxxx=

# Revolut Business (placeholders). The PEM goes in double quotes with \n between its lines.
REVOLUT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-pkcs8-key\n-----END PRIVATE KEY-----"
# REVOLUT_CLIENT_ID=your-revolut-api-client-id

# Local overrides of public vars. The browser talks to the Vite dev server on 5173, which proxies
# /api to the Worker on 8787, so the redirect URI uses port 5173.
OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/callback
EXACT_REDIRECT_URI=http://localhost:5173/api/connections/exact/callback
# Revolut only accepts an https redirect URI on the app's own origin, so the Revolut connect flow
# needs an https tunnel locally (set OAUTH_REDIRECT_URI to the same origin). With plain
# http://localhost the Revolut card reports "not set up on the server".
# REVOLUT_REDIRECT_URI=https://your-tunnel.example/api/connections/revolut/callback
# REVOLUT_ISSUER=your-tunnel.example
# EXACT_CLIENT_ID=your-exact-app-client-id
# Needed locally until the committed placeholder is filled:
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
